# Optional override for self-hosted/pinned builds. With no .env.local-model,
# the desktop retrieves the key automatically from the official Luczor HTTPS API.
# Configure BOTH values when overriding. Never place a private key here.
LUCZOR_LOCAL_MODEL_MANIFEST_KEY_ID=luczor-local-model-production-YYYY-NN
LUCZOR_LOCAL_MODEL_MANIFEST_PUBLIC_KEY_B64=BASE64_ENCODED_PUBLIC_PEM

# Per-device runtime paths. They are read only at runtime and are not baked into a release.
LUCZOR_LLAMA_CPP_BIN=C:\absolute\path\to\llama-server.exe
LUCZOR_LOCAL_MODEL_DIR=D:\absolute\path\to\luczor-models
