{
  "name": "tauri-app",
  "private": true,
  "version": "2.9.3",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm vite:dev",
    "vite:dev": "cross-env DEBUG=0 vite",
    "lint": "eslint src tests --suppressions-location eslint-suppressions.json",
    "format": "prettier --write src tests *.cjs *.ts *.json",
    "format:check": "prettier --check src tests *.cjs *.ts *.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:teams": "vitest run tests/unit/agentTeams.test.ts tests/unit/agentTeamsUi.test.ts tests/unit/agentTeamTools.test.ts tests/unit/agentOrchestrator.test.ts tests/unit/codexAgent.test.ts tests/unit/executionGate.test.ts tests/unit/deviceJobs.test.ts tests/unit/localContextRetrieval.test.ts",
    "lab:teams": "vite --host 127.0.0.1 --port 1433 --strictPort",
    "test:planning": "vitest run tests/unit/planning tests/unit/planPrincipal.test.ts src/services/plan.spec.ts",
    "lab:planning": "vite --host 127.0.0.1 --port 1433 --strictPort",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build-agent-runtime.mjs && vue-tsc --build --force && vite build && node scripts/build-workflow-editor.mjs",
    "build:workflow-editor": "node scripts/build-workflow-editor.mjs",
    "build:agent-runtime": "node scripts/build-agent-runtime.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "type-check": "pnpm typecheck",
    "tauri": "node scripts/tauri-launch.cjs",
    "setup:desktop": "bash scripts/setup-desktop.sh --install",
    "doctor:desktop": "bash scripts/setup-desktop.sh --check",
    "bump": "node bump-version.cjs",
    "version:check": "node check-version.cjs",
    "node:check": "node scripts/release-readiness.cjs --mode node",
    "release:check:local": "node scripts/release-readiness.cjs --mode local-test",
    "release:check:production": "node scripts/release-readiness.cjs --mode production",
    "release:check:test": "node --test scripts/release-readiness.test.cjs scripts/check-unsigned-pe.test.cjs",
    "release:installer:windows:test": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-test-installer.ps1",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "security:audit": "pnpm audit --audit-level=moderate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.266",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@vue-flow/core": "1.48.2",
    "pinia": "^3.0.4",
    "pusher-js": "^8.6.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/types": "^2.0.0",
    "@pinia/testing": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.11.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  }
}
